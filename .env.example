# Copy to .env. Never commit credentials. Restart the server after edits.
AGENT_MODE=live
RETRIEVAL_BACKEND=vector
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=16384
LLM_PLANNER_MAX_TOKENS=4096
LLM_PLANNER_TIMEOUT_SECONDS=60
# auto: enable DeepSeek thinking; omit for other models.
# enabled/disabled explicitly sends the provider's thinking.type parameter.
LLM_THINKING=auto
# Explicitly choose mock only for UI/pipeline checks.
